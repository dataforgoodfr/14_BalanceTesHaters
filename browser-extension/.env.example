# Pour utiliser le backend local, décommenter les deux variables.
# VITE_BACKEND_API_BASE_URL=http://localhost:8000
# VITE_BACKEND_API_TOKEN=local-development-public-token

# Pour un backend distant, remplacer l'URL et le token par ses valeurs.
# Le token doit correspondre à BTH_PUBLIC_API_TOKEN, jamais au token privé.
# VITE_BACKEND_API_TOKEN=<a retrouver sur le vaultwarden du projet>

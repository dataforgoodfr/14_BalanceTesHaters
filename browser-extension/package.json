{
  "name": "bth-extension",
  "private": true,
  "version": "0.0.0-dev",
  "type": "module",
  "scripts": {
    "dev": "pnpm wxt",
    "dev:fullstack": "concurrently --kill-signal SIGINT --kill-timeout 15000 --names backend,extension \"docker compose -p bth-local -f ../backend/compose.dev.yml up --build --abort-on-container-exit\" \"VITE_BACKEND_API_BASE_URL=http://localhost:8000 VITE_BACKEND_API_TOKEN=local-development-public-token pnpm dev\"",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "check": "pnpm compile && pnpm lint && pnpm format:check && pnpm test run",
    "check-all": "pnpm check && pnpm test:e2e:build",
    "test:e2e": "PATH_TO_EXTENSION=../.output/chrome-mv3-dev playwright test",
    "test:e2e:build": "pnpm build && PATH_TO_EXTENSION=../.output/chrome-mv3 playwright test",
    "test:e2e:ui": "PATH_TO_EXTENSION=../.output/chrome-mv3-dev playwright test --ui",
    "test:e2e:debug": "PATH_TO_EXTENSION=../.output/chrome-mv3-dev playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:soak:browser": "VITE_SOAK_TEST_BUILD=true pnpm dev",
    "test:soak:server": "tsx soak-test/main.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/red-hat-display": "^5.3.0",
    "@fontsource-variable/red-hat-text": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "@stepperize/react": "^8.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.11.0",
    "image-js": "^1.7.1",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "@daypicker/react": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tslog": "^5.2.0",
    "tw-animate-css": "^1.4.0",
    "uint8-to-base64": "^0.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.27.2",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.2",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "publish-browser-extension": "^6.2.0",
    "storybook": "^10.6.2",
    "tailwind-csstree": "^0.4.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "web-ext": ">=10.8.0",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "24.x"
  }
}
